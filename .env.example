# Copy this file to .env and replace every change-me value.
DB_ROOT_PASSWORD=change-me-root-password
DB_NAME=espocrm
DB_USER=espocrm
DB_PASSWORD=change-me-database-password

ESPOCRM_ADMIN_USERNAME=admin
ESPOCRM_ADMIN_PASSWORD=change-me-admin-password
ESPOCRM_PORT=8080
ESPOCRM_SITE_URL=http://localhost:8080
ESPOCRM_WEBSOCKET_PORT=8081
ESPOCRM_WEBSOCKET_URL=ws://localhost:8081

# Legacy AI provider. Empty key retains explicitly labeled deterministic demo drafts.
# New text configuration below takes precedence and never silently falls back to mock.
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT=30
AI_MAX_RETRIES=2

# Mounted inside the EspoCRM container.
KNOWLEDGE_BASE_PATH=/var/www/html/knowledge
FUSANHE_KNOWLEDGE_MAX_BYTES=26214400
MATERIAL_LIBRARY_PATH=/var/www/html/materials
FUSANHE_AUTOMATION_TOKEN=replace-with-a-long-random-token
FUSANHE_AGENT_CREDENTIAL_TTL_DAYS=90
# Temporary shared-token fallback for agents without an issued credential.
# Leave empty to disable. Remove after the documented 2026-10-31 migration cutoff.
FUSANHE_AUTOMATION_LEGACY_UNTIL=
FUSANHE_OUTBOUND_PAUSED=true

# Alibaba Bridge (api.fsh.digital)
ALIBABA_BRIDGE_URL=https://api.fsh.digital
ALIBABA_BRIDGE_TOKEN=replace-with-bridge-token

# Industry module feature flags (optional, default off = module hidden).
# Flags only hide entries; permissions are enforced server-side regardless.
# FUSANHE_FEATURE_PRODUCTS=1
# FUSANHE_FEATURE_CERTIFICATES=1
# FUSANHE_FEATURE_SAMPLES=1
# FUSANHE_FEATURE_QUOTES=1
# FUSANHE_FEATURE_ORDERS=1

# Independent text relay (server only). Model IDs verified against the relay catalog.
FUSANHE_TEXT_ENABLED=false
FUSANHE_TEXT_API_BASE_URL=https://gw.apimonth.com/v1
FUSANHE_TEXT_API_KEY=
FUSANHE_TEXT_MODEL_GPT=gpt-6.1-sol
FUSANHE_TEXT_MODEL_GROK=grok-4.7
FUSANHE_TEXT_MODEL_GEMINI=gemini-3.8-flash
FUSANHE_TEXT_DEFAULT_MODEL=gpt
FUSANHE_TEXT_TIMEOUT=45

# Independent media relay. H3 Max is VIDEO ONLY; static images need a separate model.
FUSANHE_MEDIA_API_BASE_URL=https://tokendance.space/gateway/v1
FUSANHE_MEDIA_API_KEY=
FUSANHE_MEDIA_VIDEO_MODEL=minimax-h3-max
FUSANHE_MEDIA_IMAGE_MODEL=
FUSANHE_MEDIA_ENABLED=false
FUSANHE_MEDIA_MAX_DAILY_JOBS=20
FUSANHE_MEDIA_MAX_ACTIVE_JOBS=2
FUSANHE_CREATIVE_MAX_DAILY_PLANS=20
