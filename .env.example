# Copy this file to .env and replace every change-me value.
DB_ROOT_PASSWORD=change-me-root-password
DB_NAME=espocrm
DB_USER=espocrm
DB_PASSWORD=change-me-database-password

ESPOCRM_ADMIN_USERNAME=admin
ESPOCRM_ADMIN_PASSWORD=change-me-admin-password
ESPOCRM_PORT=8080
ESPOCRM_SITE_URL=http://localhost:8080
ESPOCRM_WEBSOCKET_PORT=8081
ESPOCRM_WEBSOCKET_URL=ws://localhost:8081

# AI provider (OpenAI-compatible). Leave the key empty to use deterministic mock mode.
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT=30
AI_MAX_RETRIES=2

# Mounted inside the EspoCRM container.
KNOWLEDGE_BASE_PATH=/var/www/html/knowledge
MATERIAL_LIBRARY_PATH=/var/www/html/materials
FUSANHE_AUTOMATION_TOKEN=replace-with-a-long-random-token
FUSANHE_OUTBOUND_PAUSED=true

# Alibaba Bridge (api.fsh.digital)
ALIBABA_BRIDGE_URL=https://api.fsh.digital
ALIBABA_BRIDGE_TOKEN=replace-with-bridge-token
