# Copy to .env.test for the isolated tests/phase1-compose.yaml stack only.
# These fixture placeholders must never be reused for production.
DB_ROOT_PASSWORD=phase1-test-root-password
DB_NAME=espocrm
DB_USER=espocrm
DB_PASSWORD=phase1-test-database-password

ESPOCRM_ADMIN_USERNAME=admin
ESPOCRM_ADMIN_PASSWORD=123456
ESPOCRM_PORT=18080
ESPOCRM_SITE_URL=http://localhost:18080

FUSANHE_AUTOMATION_TOKEN=phase1-test-automation-token-0123456789abcdef
FUSANHE_OUTBOUND_PAUSED=true

# Deterministic/no-key test defaults used by the isolated EspoCRM container.
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# Keep optional industry modules hidden in the test fixture unless a scenario
# explicitly needs one. Feature flags never replace server-side permissions.
FUSANHE_FEATURE_PRODUCTS=0
FUSANHE_FEATURE_CERTIFICATES=0
FUSANHE_FEATURE_SAMPLES=0
FUSANHE_FEATURE_QUOTES=0
FUSANHE_FEATURE_ORDERS=0
