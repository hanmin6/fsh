MIC_APP_DATA_DIR=G:\MadeInChinaGatewayData
MIC_HOST=0.0.0.0
MIC_PORT=8787
MIC_CONVERSATION_SYNC_SECONDS=30
MIC_ORDER_SYNC_SECONDS=300
MIC_CONVERSATION_STALE_SECONDS=120
MIC_ORDER_STALE_SECONDS=900
MIC_SELLER_URL=https://membercenter.made-in-china.com/
MIC_SEND_INTERVAL_SECONDS=10
MIC_CHROMIUM_HEADLESS=false
MIC_MAX_REQUEST_BYTES=65536

# Optional MIC -> CRM bridge settings. Bridge commands read the process
# environment directly; export these values before running the bridge CLI.
# Keep MIC_APP_DATA_DIR outside the source tree and restrict its ACL.
MIC_GATEWAY_URL=http://127.0.0.1:8787
MIC_ACCOUNT_HANDLE=replace-with-seller-account-handle
MIC_CRM_URL=http://127.0.0.1:8080
MIC_CRM_AGENT_KEY=mic-agent
MIC_CRM_ALLOW_REMOTE_HTTPS=false
# Create separate MIC Gateway keys with roles crm_read and agent_send.
MIC_CRM_READ_API_KEY=
MIC_CRM_SEND_API_KEY=
# Bootstrap token is only for the explicit `register` command.
MIC_CRM_BOOTSTRAP_TOKEN=
# Set only after register returns the one-time CRM Agent credential.
MIC_CRM_AGENT_TOKEN=
