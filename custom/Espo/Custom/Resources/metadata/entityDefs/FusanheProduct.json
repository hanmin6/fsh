{
  "fields": {
    "name": {
      "type": "varchar",
      "required": true,
      "maxLength": 255
    },
    "nameEn": {
      "type": "varchar",
      "maxLength": 255
    },
    "code": {
      "type": "varchar",
      "maxLength": 100
    },
    "description": {
      "type": "text"
    },
    "category": {
      "type": "varchar",
      "maxLength": 100
    },
    "status": {
      "type": "enum",
      "options": [
        "enabled",
        "disabled"
      ],
      "default": "enabled",
      "displayAsLabel": true
    },
    "defaultMoq": {
      "type": "float",
      "min": 0
    },
    "defaultMoqUnit": {
      "type": "enum",
      "options": [
        "carton",
        "ctn",
        "kg",
        "g",
        "ton",
        "pcs",
        "set",
        "box",
        "bottle",
        "can",
        "bag",
        "container20",
        "container40"
      ]
    },
    "assignedUser": {
      "type": "link",
      "view": "views/fields/assigned-user"
    },
    "teams": {
      "type": "linkMultiple",
      "view": "views/fields/teams"
    },
    "createdAt": {
      "type": "datetime",
      "readOnly": true
    },
    "modifiedAt": {
      "type": "datetime",
      "readOnly": true
    },
    "createdBy": {
      "type": "link",
      "readOnly": true
    },
    "modifiedBy": {
      "type": "link",
      "readOnly": true
    }
  },
  "links": {
    "assignedUser": {
      "type": "belongsTo",
      "entity": "User"
    },
    "teams": {
      "type": "hasMany",
      "entity": "Team",
      "relationName": "entityTeam",
      "layoutRelationshipsDisabled": true
    },
    "createdBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "modifiedBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "specs": {
      "type": "hasMany",
      "entity": "FusanheProductSpec",
      "foreign": "product"
    }
  },
  "collection": {
    "orderBy": "createdAt",
    "order": "desc",
    "textFilterFields": [
      "name",
      "nameEn",
      "code",
      "category"
    ]
  },
  "indexes": {
    "code": {
      "columns": [
        "code"
      ]
    }
  }
}
