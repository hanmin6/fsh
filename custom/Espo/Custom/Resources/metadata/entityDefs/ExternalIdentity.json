{
  "fields": {
    "name": {
      "type": "varchar",
      "required": true,
      "maxLength": 255
    },
    "description": {
      "type": "text"
    },
    "createdAt": {
      "type": "datetime",
      "readOnly": true
    },
    "modifiedAt": {
      "type": "datetime",
      "readOnly": true
    },
    "createdBy": {
      "type": "link",
      "readOnly": true
    },
    "modifiedBy": {
      "type": "link",
      "readOnly": true
    },
    "assignedUser": {
      "type": "link",
      "view": "views/fields/assigned-user",
      "audited": true
    },
    "teams": {
      "type": "linkMultiple",
      "view": "views/fields/teams"
    },
    "identityKey": {
      "type": "varchar",
      "required": true,
      "maxLength": 191,
      "readOnly": true
    },
    "channelType": {
      "type": "enum",
      "options": [
        "Alibaba",
        "MadeInChina",
        "Website",
        "Email",
        "WhatsApp",
        "Other"
      ],
      "default": "Other"
    },
    "channelAccountId": {
      "type": "varchar",
      "maxLength": 191,
      "default": "default"
    },
    "externalUserId": {
      "type": "varchar",
      "maxLength": 191
    },
    "displayName": {
      "type": "varchar",
      "maxLength": 255
    },
    "emailAddress": {
      "type": "varchar",
      "maxLength": 255
    },
    "phoneNumber": {
      "type": "varchar",
      "maxLength": 100
    },
    "country": {
      "type": "varchar",
      "maxLength": 100
    },
    "linkStatus": {
      "type": "enum",
      "options": [
        "unlinked",
        "confirmed"
      ],
      "default": "unlinked",
      "displayAsLabel": true
    },
    "confirmedBy": {
      "type": "link",
      "readOnly": true
    },
    "confirmedAt": {
      "type": "datetime",
      "readOnly": true
    },
    "firstSeenAt": {
      "type": "datetime",
      "readOnly": true
    },
    "lastSeenAt": {
      "type": "datetime",
      "readOnly": true
    },
    "notes": {
      "type": "text"
    }
  },
  "links": {
    "createdBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "modifiedBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "assignedUser": {
      "type": "belongsTo",
      "entity": "User"
    },
    "teams": {
      "type": "hasMany",
      "entity": "Team",
      "relationName": "entityTeam",
      "layoutRelationshipsDisabled": true
    },
    "confirmedBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "account": {
      "type": "belongsTo",
      "entity": "Account"
    },
    "contact": {
      "type": "belongsTo",
      "entity": "Contact"
    },
    "lead": {
      "type": "belongsTo",
      "entity": "Lead"
    },
    "conversations": {
      "type": "hasMany",
      "entity": "ExternalConversation",
      "foreign": "identity"
    }
  },
  "collection": {
    "orderBy": "lastSeenAt",
    "order": "desc",
    "textFilterFields": [
      "name",
      "displayName",
      "externalUserId",
      "emailAddress"
    ]
  },
  "indexes": {
    "identityKey": {
      "columns": [
        "identityKey"
      ],
      "unique": true
    },
    "linkStatus": {
      "columns": [
        "linkStatus"
      ]
    }
  }
}
