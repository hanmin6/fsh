{
  "fields": {
    "name": {
      "type": "varchar",
      "required": true,
      "maxLength": 255
    },
    "description": {
      "type": "text"
    },
    "createdAt": {
      "type": "datetime",
      "readOnly": true
    },
    "modifiedAt": {
      "type": "datetime",
      "readOnly": true
    },
    "createdBy": {
      "type": "link",
      "readOnly": true
    },
    "modifiedBy": {
      "type": "link",
      "readOnly": true
    },
    "assignedUser": {
      "type": "link",
      "view": "views/fields/assigned-user",
      "audited": true
    },
    "teams": {
      "type": "linkMultiple",
      "view": "views/fields/teams"
    },
    "conversation": {
      "type": "link",
      "required": true
    },
    "sourceMessage": {
      "type": "link",
      "required": true
    },
    "draftText": {
      "type": "text",
      "required": true
    },
    "translatedText": {
      "type": "text"
    },
    "wasEdited": {
      "type": "bool",
      "default": false,
      "readOnly": true
    },
    "intent": {
      "type": "varchar",
      "maxLength": 255
    },
    "summaryZh": {
      "type": "text"
    },
    "suggestedLanguage": {
      "type": "varchar",
      "maxLength": 20
    },
    "missingInformation": {
      "type": "jsonArray",
      "view": "custom:views/fields/structured"
    },
    "confidence": {
      "type": "float",
      "min": 0,
      "max": 1
    },
    "riskLevel": {
      "type": "enum",
      "options": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium",
      "displayAsLabel": true
    },
    "citedKnowledge": {
      "type": "jsonArray",
      "view": "custom:views/fields/structured"
    },
    "modelProvider": {
      "type": "varchar",
      "maxLength": 100
    },
    "modelName": {
      "type": "varchar",
      "maxLength": 100
    },
    "promptVersion": {
      "type": "varchar",
      "maxLength": 50
    },
    "status": {
      "type": "enum",
      "options": [
        "generated",
        "edited",
        "approved",
        "rejected",
        "sent"
      ],
      "default": "generated",
      "displayAsLabel": true,
      "audited": true
    },
    "approvedBy": {
      "type": "link",
      "readOnly": true
    },
    "approvedAt": {
      "type": "datetime",
      "readOnly": true
    }
  },
  "links": {
    "createdBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "modifiedBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "assignedUser": {
      "type": "belongsTo",
      "entity": "User"
    },
    "teams": {
      "type": "hasMany",
      "entity": "Team",
      "relationName": "entityTeam",
      "layoutRelationshipsDisabled": true
    },
    "conversation": {
      "type": "belongsTo",
      "entity": "ExternalConversation",
      "foreign": "replyDrafts"
    },
    "sourceMessage": {
      "type": "belongsTo",
      "entity": "ExternalMessage"
    },
    "approvedBy": {
      "type": "belongsTo",
      "entity": "User"
    }
  },
  "collection": {
    "orderBy": "createdAt",
    "order": "desc",
    "textFilterFields": [
      "name"
    ]
  },
  "indexes": {
    "conversationStatus": {
      "columns": [
        "conversationId",
        "status"
      ]
    }
  }
}
