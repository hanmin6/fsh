{
  "fields": {
    "name": {
      "type": "varchar",
      "required": true,
      "maxLength": 255
    },
    "description": {
      "type": "text"
    },
    "type": {
      "type": "enum",
      "required": true,
      "options": [
        "businessLicense",
        "iso22000",
        "haccp",
        "brc",
        "ifs",
        "halal",
        "kosher",
        "fdaRegistration",
        "healthCertificate",
        "testReport",
        "other"
      ],
      "displayAsLabel": true
    },
    "scopeLevel": {
      "type": "enum",
      "options": [
        "factory",
        "product",
        "batch"
      ],
      "default": "factory",
      "displayAsLabel": true
    },
    "factoryName": {
      "type": "varchar",
      "maxLength": 255
    },
    "product": {
      "type": "link"
    },
    "productSpec": {
      "type": "link"
    },
    "batchCode": {
      "type": "varchar",
      "maxLength": 100
    },
    "issuer": {
      "type": "varchar",
      "maxLength": 255
    },
    "certificateNo": {
      "type": "varchar",
      "maxLength": 191
    },
    "issueDate": {
      "type": "date"
    },
    "validFrom": {
      "type": "date"
    },
    "validTo": {
      "type": "date"
    },
    "status": {
      "type": "enum",
      "options": [
        "draft",
        "approved",
        "revoked"
      ],
      "default": "draft",
      "displayAsLabel": true
    },
    "reviewer": {
      "type": "link",
      "readOnly": true
    },
    "reviewedAt": {
      "type": "datetime",
      "readOnly": true
    },
    "files": {
      "type": "attachmentMultiple",
      "view": "views/fields/attachments-multiple"
    },
    "markets": {
      "type": "text"
    },
    "notes": {
      "type": "text"
    },
    "assignedUser": {
      "type": "link",
      "view": "views/fields/assigned-user"
    },
    "teams": {
      "type": "linkMultiple",
      "view": "views/fields/teams"
    },
    "createdAt": {
      "type": "datetime",
      "readOnly": true
    },
    "modifiedAt": {
      "type": "datetime",
      "readOnly": true
    },
    "createdBy": {
      "type": "link",
      "readOnly": true
    },
    "modifiedBy": {
      "type": "link",
      "readOnly": true
    }
  },
  "links": {
    "product": {
      "type": "belongsTo",
      "entity": "FusanheProduct"
    },
    "productSpec": {
      "type": "belongsTo",
      "entity": "FusanheProductSpec"
    },
    "reviewer": {
      "type": "belongsTo",
      "entity": "User"
    },
    "assignedUser": {
      "type": "belongsTo",
      "entity": "User"
    },
    "teams": {
      "type": "hasMany",
      "entity": "Team",
      "relationName": "entityTeam",
      "layoutRelationshipsDisabled": true
    },
    "createdBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "modifiedBy": {
      "type": "belongsTo",
      "entity": "User"
    }
  },
  "collection": {
    "orderBy": "createdAt",
    "order": "desc",
    "textFilterFields": [
      "name",
      "certificateNo",
      "issuer"
    ]
  },
  "indexes": {
    "certificateNo": {
      "columns": [
        "certificateNo"
      ]
    },
    "statusValidTo": {
      "columns": [
        "status",
        "validTo"
      ]
    }
  }
}
