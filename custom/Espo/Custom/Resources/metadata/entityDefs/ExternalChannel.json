{
  "fields": {
    "name": {
      "type": "varchar",
      "required": true,
      "maxLength": 255
    },
    "description": {
      "type": "text"
    },
    "createdAt": {
      "type": "datetime",
      "readOnly": true
    },
    "modifiedAt": {
      "type": "datetime",
      "readOnly": true
    },
    "createdBy": {
      "type": "link",
      "readOnly": true
    },
    "modifiedBy": {
      "type": "link",
      "readOnly": true
    },
    "assignedUser": {
      "type": "link",
      "view": "views/fields/assigned-user",
      "audited": true
    },
    "teams": {
      "type": "linkMultiple",
      "view": "views/fields/teams"
    },
    "type": {
      "type": "enum",
      "options": [
        "Alibaba",
        "MadeInChina",
        "Website",
        "Email",
        "WhatsApp",
        "Other"
      ],
      "default": "Other"
    },
    "accountHandle": {
      "type": "varchar",
      "maxLength": 191,
      "default": "default"
    },
    "enabled": {
      "type": "bool",
      "default": true
    },
    "connectionStatus": {
      "type": "enum",
      "options": [
        "unknown",
        "healthy",
        "degraded",
        "offline"
      ],
      "default": "unknown"
    },
    "lastSyncAt": {
      "type": "datetime"
    },
    "config": {
      "type": "jsonObject",
      "layoutListDisabled": true,
      "layoutMassUpdateDisabled": true,
      "view": "custom:views/fields/structured"
    }
  },
  "links": {
    "createdBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "modifiedBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "assignedUser": {
      "type": "belongsTo",
      "entity": "User"
    },
    "teams": {
      "type": "hasMany",
      "entity": "Team",
      "relationName": "entityTeam",
      "layoutRelationshipsDisabled": true
    },
    "conversations": {
      "type": "hasMany",
      "entity": "ExternalConversation",
      "foreign": "channel"
    }
  },
  "collection": {
    "orderBy": "createdAt",
    "order": "desc",
    "textFilterFields": [
      "name"
    ]
  },
  "indexes": {
    "type": {
      "columns": [
        "type"
      ]
    },
    "typeAccountHandle": {
      "columns": [
        "type",
        "accountHandle"
      ],
      "unique": true
    }
  }
}
