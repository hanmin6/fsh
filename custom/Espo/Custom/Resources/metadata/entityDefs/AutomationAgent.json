{
  "fields": {
    "name": {
      "type": "varchar",
      "required": true,
      "maxLength": 255
    },
    "description": {
      "type": "text"
    },
    "createdAt": {
      "type": "datetime",
      "readOnly": true
    },
    "modifiedAt": {
      "type": "datetime",
      "readOnly": true
    },
    "createdBy": {
      "type": "link",
      "readOnly": true
    },
    "modifiedBy": {
      "type": "link",
      "readOnly": true
    },
    "assignedUser": {
      "type": "link",
      "view": "views/fields/assigned-user",
      "audited": true
    },
    "teams": {
      "type": "linkMultiple",
      "view": "views/fields/teams"
    },
    "agentKey": {
      "type": "varchar",
      "required": true,
      "maxLength": 100
    },
    "mode": {
      "type": "enum",
      "options": [
        "mock",
        "real"
      ],
      "default": "mock",
      "displayAsLabel": true
    },
    "status": {
      "type": "enum",
      "options": [
        "online",
        "offline",
        "loginExpired",
        "captcha",
        "pageChanged",
        "riskControl"
      ],
      "default": "offline",
      "displayAsLabel": true
    },
    "lastHeartbeatAt": {
      "type": "datetime"
    },
    "capabilities": {
      "type": "jsonArray",
      "view": "custom:views/fields/structured"
    },
    "lastError": {
      "type": "text"
    },
    "credentialHash": {
      "type": "varchar",
      "maxLength": 255,
      "readOnly": true
    },
    "credentialVersion": {
      "type": "int",
      "default": 0,
      "readOnly": true
    },
    "credentialIssuedAt": {
      "type": "datetime",
      "readOnly": true
    },
    "credentialExpiresAt": {
      "type": "datetime",
      "readOnly": true
    },
    "credentialRevokedAt": {
      "type": "datetime",
      "readOnly": true
    },
    "credentialLastUsedAt": {
      "type": "datetime",
      "readOnly": true
    }
  },
  "links": {
    "createdBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "modifiedBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "assignedUser": {
      "type": "belongsTo",
      "entity": "User"
    },
    "teams": {
      "type": "hasMany",
      "entity": "Team",
      "relationName": "entityTeam",
      "layoutRelationshipsDisabled": true
    }
  },
  "collection": {
    "orderBy": "createdAt",
    "order": "desc",
    "textFilterFields": [
      "name"
    ]
  },
  "indexes": {
    "agentKey": {
      "columns": [
        "agentKey"
      ],
      "unique": true
    }
  }
}
