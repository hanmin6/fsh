{
  "fields": {
    "name": {
      "type": "varchar",
      "required": true,
      "maxLength": 255
    },
    "description": {
      "type": "text"
    },
    "createdAt": {
      "type": "datetime",
      "readOnly": true
    },
    "modifiedAt": {
      "type": "datetime",
      "readOnly": true
    },
    "createdBy": {
      "type": "link",
      "readOnly": true
    },
    "modifiedBy": {
      "type": "link",
      "readOnly": true
    },
    "assignedUser": {
      "type": "link",
      "view": "views/fields/assigned-user",
      "audited": true
    },
    "teams": {
      "type": "linkMultiple",
      "view": "views/fields/teams"
    },
    "conversation": {
      "type": "link",
      "required": true
    },
    "externalId": {
      "type": "varchar",
      "required": true,
      "maxLength": 191
    },
    "direction": {
      "type": "enum",
      "options": [
        "inbound",
        "outbound"
      ],
      "required": true
    },
    "senderName": {
      "type": "varchar",
      "maxLength": 255
    },
    "senderExternalId": {
      "type": "varchar",
      "maxLength": 191
    },
    "sentAt": {
      "type": "datetime",
      "required": true
    },
    "body": {
      "type": "text",
      "required": true
    },
    "translatedBody": {
      "type": "text"
    },
    "attachmentMetadata": {
      "type": "jsonObject",
      "view": "custom:views/fields/structured"
    },
    "deliveryStatus": {
      "type": "enum",
      "options": [
        "received",
        "queued",
        "sending",
        "sent",
        "mockSent",
        "delivered",
        "failed"
      ],
      "default": "received"
    },
    "rawPayload": {
      "type": "jsonObject",
      "layoutListDisabled": true,
      "view": "custom:views/fields/structured"
    },
    "sourceTimestampRaw": {
      "type": "varchar",
      "maxLength": 255,
      "readOnly": true,
      "layoutListDisabled": true,
      "layoutMassUpdateDisabled": true
    },
    "timestampConfidence": {
      "type": "enum",
      "options": [
        "high",
        "medium",
        "low"
      ],
      "default": "low",
      "readOnly": true,
      "layoutListDisabled": true,
      "layoutMassUpdateDisabled": true
    },
    "sourceSequence": {
      "type": "int",
      "min": 1,
      "readOnly": true,
      "layoutListDisabled": true,
      "layoutMassUpdateDisabled": true
    },
    "messageType": {
      "type": "enum",
      "options": [
        "initialInquiry",
        "chat"
      ],
      "default": "chat",
      "readOnly": true,
      "layoutListDisabled": true,
      "layoutMassUpdateDisabled": true
    },
    "contentHash": {
      "type": "varchar",
      "required": true,
      "maxLength": 64
    }
  },
  "links": {
    "createdBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "modifiedBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "assignedUser": {
      "type": "belongsTo",
      "entity": "User"
    },
    "teams": {
      "type": "hasMany",
      "entity": "Team",
      "relationName": "entityTeam",
      "layoutRelationshipsDisabled": true
    },
    "conversation": {
      "type": "belongsTo",
      "entity": "ExternalConversation",
      "foreign": "messages"
    }
  },
  "collection": {
    "orderBy": "sentAt",
    "order": "desc",
    "textFilterFields": [
      "name"
    ]
  },
  "indexes": {
    "conversationHash": {
      "columns": [
        "conversationId",
        "contentHash"
      ],
      "unique": true
    },
    "externalId": {
      "columns": [
        "externalId"
      ]
    },
    "sentAt": {
      "columns": [
        "sentAt"
      ]
    }
  }
}
