{
  "fields": {
    "name": {
      "type": "varchar",
      "required": true,
      "maxLength": 255
    },
    "description": {
      "type": "text"
    },
    "createdAt": {
      "type": "datetime",
      "readOnly": true
    },
    "modifiedAt": {
      "type": "datetime",
      "readOnly": true
    },
    "createdBy": {
      "type": "link",
      "readOnly": true
    },
    "modifiedBy": {
      "type": "link",
      "readOnly": true
    },
    "assignedUser": {
      "type": "link",
      "view": "views/fields/assigned-user",
      "audited": true
    },
    "teams": {
      "type": "linkMultiple",
      "view": "views/fields/teams"
    },
    "channel": {
      "type": "link",
      "required": true
    },
    "externalId": {
      "type": "varchar",
      "required": true,
      "maxLength": 191
    },
    "account": {
      "type": "link"
    },
    "contact": {
      "type": "link"
    },
    "lead": {
      "type": "link"
    },
    "identity": {
      "type": "link"
    },
    "subject": {
      "type": "varchar",
      "maxLength": 255
    },
    "status": {
      "type": "enum",
      "options": [
        "new",
        "pending",
        "drafted",
        "waitingApproval",
        "readyToSend",
        "sending",
        "sent",
        "failed",
        "replied",
        "closed"
      ],
      "default": "new",
      "displayAsLabel": true,
      "audited": true
    },
    "controlMode": {
      "type": "enum",
      "options": [
        "aiAssist",
        "human"
      ],
      "default": "aiAssist",
      "displayAsLabel": true
    },
    "unreadCount": {
      "type": "int",
      "default": 0,
      "min": 0
    },
    "lastMessageAt": {
      "type": "datetime"
    },
    "lastMessagePreview": {
      "type": "varchar",
      "maxLength": 255,
      "readOnly": true
    },
    "waitingMinutes": {
      "type": "int",
      "readOnly": true
    },
    "lastInboundAt": {
      "type": "datetime"
    },
    "lastOutboundAt": {
      "type": "datetime"
    },
    "sourceUrl": {
      "type": "url"
    },
    "product": {
      "type": "varchar",
      "maxLength": 255
    },
    "country": {
      "type": "varchar",
      "maxLength": 100
    },
    "language": {
      "type": "varchar",
      "maxLength": 20
    },
    "externalUserId": {
      "type": "varchar",
      "maxLength": 191
    },
    "sourceCreatedAtRaw": {
      "type": "varchar",
      "maxLength": 255,
      "readOnly": true,
      "layoutListDisabled": true,
      "layoutMassUpdateDisabled": true
    },
    "sourceUpdatedAtRaw": {
      "type": "varchar",
      "maxLength": 255,
      "readOnly": true,
      "layoutListDisabled": true,
      "layoutMassUpdateDisabled": true
    },
    "lastSourceSyncAt": {
      "type": "datetime",
      "readOnly": true,
      "layoutListDisabled": true,
      "layoutMassUpdateDisabled": true
    },
    "backfillCompletedAt": {
      "type": "datetime",
      "readOnly": true,
      "layoutListDisabled": true,
      "layoutMassUpdateDisabled": true
    },
    "syncError": {
      "type": "text",
      "readOnly": true,
      "layoutListDisabled": true,
      "layoutMassUpdateDisabled": true
    },
    "needsManualMatch": {
      "type": "bool",
      "default": false
    },
    "firstResponseMinutes": {
      "type": "int"
    },
    "slaBreached": {
      "type": "bool",
      "default": false,
      "readOnly": true
    },
    "insightsStatus": {
      "type": "enum",
      "readOnly": true,
      "layoutMassUpdateDisabled": true,
      "options": [
        "pending",
        "completed",
        "failed",
        "stale"
      ],
      "default": "pending"
    },
    "insightsVersion": {
      "type": "varchar",
      "readOnly": true,
      "layoutMassUpdateDisabled": true,
      "maxLength": 191
    },
    "insightsModel": {
      "type": "varchar",
      "readOnly": true,
      "layoutMassUpdateDisabled": true,
      "maxLength": 191
    },
    "insightsAt": {
      "type": "datetime",
      "readOnly": true,
      "layoutMassUpdateDisabled": true
    },
    "insightsError": {
      "type": "varchar",
      "readOnly": true,
      "layoutMassUpdateDisabled": true,
      "maxLength": 191
    },
    "insightsData": {
      "type": "jsonObject",
      "readOnly": true,
      "layoutMassUpdateDisabled": true
    }
  },
  "links": {
    "createdBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "modifiedBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "assignedUser": {
      "type": "belongsTo",
      "entity": "User"
    },
    "teams": {
      "type": "hasMany",
      "entity": "Team",
      "relationName": "entityTeam",
      "layoutRelationshipsDisabled": true
    },
    "channel": {
      "type": "belongsTo",
      "entity": "ExternalChannel",
      "foreign": "conversations"
    },
    "account": {
      "type": "belongsTo",
      "entity": "Account"
    },
    "contact": {
      "type": "belongsTo",
      "entity": "Contact"
    },
    "lead": {
      "type": "belongsTo",
      "entity": "Lead"
    },
    "identity": {
      "type": "belongsTo",
      "entity": "ExternalIdentity",
      "foreign": "conversations"
    },
    "messages": {
      "type": "hasMany",
      "entity": "ExternalMessage",
      "foreign": "conversation"
    },
    "replyDrafts": {
      "type": "hasMany",
      "entity": "AIReplyDraft",
      "foreign": "conversation"
    },
    "outboundTasks": {
      "type": "hasMany",
      "entity": "OutboundTask",
      "foreign": "conversation"
    }
  },
  "collection": {
    "orderBy": "lastMessageAt",
    "order": "desc",
    "textFilterFields": [
      "name",
      "subject",
      "lastMessagePreview",
      "product",
      "country"
    ]
  },
  "indexes": {
    "channelExternal": {
      "columns": [
        "channelId",
        "externalId"
      ],
      "unique": true
    },
    "lastMessageAt": {
      "columns": [
        "lastMessageAt"
      ]
    },
    "statusAssigned": {
      "columns": [
        "status",
        "assignedUserId"
      ]
    }
  }
}
