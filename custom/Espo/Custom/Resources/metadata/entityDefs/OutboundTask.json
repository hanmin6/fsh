{
  "fields": {
    "name": {
      "type": "varchar",
      "required": true,
      "maxLength": 255
    },
    "description": {
      "type": "text"
    },
    "createdAt": {
      "type": "datetime",
      "readOnly": true
    },
    "modifiedAt": {
      "type": "datetime",
      "readOnly": true
    },
    "createdBy": {
      "type": "link",
      "readOnly": true
    },
    "modifiedBy": {
      "type": "link",
      "readOnly": true
    },
    "assignedUser": {
      "type": "link",
      "view": "views/fields/assigned-user",
      "audited": true
    },
    "teams": {
      "type": "linkMultiple",
      "view": "views/fields/teams"
    },
    "conversation": {
      "type": "link",
      "required": true
    },
    "replyDraft": {
      "type": "link",
      "required": true
    },
    "channel": {
      "type": "link",
      "required": true
    },
    "status": {
      "type": "enum",
      "options": [
        "pending",
        "claimed",
        "sending",
        "sent",
        "failed",
        "cancelled"
      ],
      "default": "pending",
      "displayAsLabel": true,
      "audited": true
    },
    "idempotencyKey": {
      "type": "varchar",
      "required": true,
      "maxLength": 100,
      "readOnly": true
    },
    "claimedBy": {
      "type": "varchar",
      "maxLength": 100
    },
    "claimedAt": {
      "type": "datetime"
    },
    "claimExpiresAt": {
      "type": "datetime"
    },
    "retryCount": {
      "type": "int",
      "default": 0,
      "min": 0
    },
    "errorMessage": {
      "type": "text"
    },
    "platformMessageId": {
      "type": "varchar",
      "maxLength": 191
    },
    "completedAt": {
      "type": "datetime"
    },
    "payload": {
      "type": "jsonObject",
      "layoutListDisabled": true,
      "view": "custom:views/fields/structured"
    },
    "executionMode": {
      "type": "enum",
      "options": [
        "mock",
        "real"
      ],
      "default": "mock",
      "displayAsLabel": true
    },
    "contentSnapshot": {
      "type": "text",
      "readOnly": true,
      "layoutListDisabled": true
    },
    "triggerType": {
      "type": "enum",
      "options": [
        "manual",
        "scheduledReception"
      ],
      "default": "manual",
      "readOnly": true
    }
  },
  "links": {
    "createdBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "modifiedBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "assignedUser": {
      "type": "belongsTo",
      "entity": "User"
    },
    "teams": {
      "type": "hasMany",
      "entity": "Team",
      "relationName": "entityTeam",
      "layoutRelationshipsDisabled": true
    },
    "conversation": {
      "type": "belongsTo",
      "entity": "ExternalConversation",
      "foreign": "outboundTasks"
    },
    "replyDraft": {
      "type": "belongsTo",
      "entity": "AIReplyDraft"
    },
    "channel": {
      "type": "belongsTo",
      "entity": "ExternalChannel"
    }
  },
  "collection": {
    "orderBy": "createdAt",
    "order": "desc",
    "textFilterFields": [
      "name"
    ]
  },
  "indexes": {
    "idempotencyKey": {
      "columns": [
        "idempotencyKey"
      ],
      "unique": true
    },
    "statusClaim": {
      "columns": [
        "status",
        "claimExpiresAt"
      ]
    }
  }
}
