{
  "fields": {
    "name": {
      "type": "varchar",
      "required": true,
      "maxLength": 255
    },
    "description": {
      "type": "text"
    },
    "createdAt": {
      "type": "datetime",
      "readOnly": true
    },
    "modifiedAt": {
      "type": "datetime",
      "readOnly": true
    },
    "createdBy": {
      "type": "link",
      "readOnly": true
    },
    "modifiedBy": {
      "type": "link",
      "readOnly": true
    },
    "assignedUser": {
      "type": "link",
      "view": "views/fields/assigned-user",
      "audited": true
    },
    "teams": {
      "type": "linkMultiple",
      "view": "views/fields/teams"
    },
    "eventType": {
      "type": "varchar",
      "required": true,
      "maxLength": 100
    },
    "actorType": {
      "type": "varchar",
      "maxLength": 50
    },
    "actorId": {
      "type": "varchar",
      "maxLength": 100
    },
    "entityType": {
      "type": "varchar",
      "maxLength": 100
    },
    "entityId": {
      "type": "varchar",
      "maxLength": 100
    },
    "requestId": {
      "type": "varchar",
      "maxLength": 64,
      "readOnly": true
    },
    "result": {
      "type": "enum",
      "options": [
        "success",
        "failure",
        "denied"
      ],
      "default": "success"
    },
    "details": {
      "type": "jsonObject",
      "view": "custom:views/fields/structured"
    }
  },
  "links": {
    "createdBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "modifiedBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "assignedUser": {
      "type": "belongsTo",
      "entity": "User"
    },
    "teams": {
      "type": "hasMany",
      "entity": "Team",
      "relationName": "entityTeam",
      "layoutRelationshipsDisabled": true
    }
  },
  "collection": {
    "orderBy": "createdAt",
    "order": "desc",
    "textFilterFields": [
      "name"
    ]
  },
  "indexes": {
    "eventAt": {
      "columns": [
        "createdAt"
      ]
    },
    "requestId": {
      "columns": [
        "requestId"
      ],
      "unique": true
    }
  }
}
