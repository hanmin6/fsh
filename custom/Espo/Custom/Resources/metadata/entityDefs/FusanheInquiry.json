{
  "fields": {
    "name": {
      "type": "varchar",
      "required": true,
      "maxLength": 255
    },
    "description": {
      "type": "text"
    },
    "number": {
      "type": "varchar",
      "maxLength": 100
    },
    "status": {
      "type": "enum",
      "options": [
        "open",
        "quoted",
        "converted",
        "cancelled"
      ],
      "default": "open",
      "displayAsLabel": true
    },
    "account": {
      "type": "link"
    },
    "contact": {
      "type": "link"
    },
    "conversation": {
      "type": "link"
    },
    "product": {
      "type": "link"
    },
    "productSpec": {
      "type": "link"
    },
    "quantity": {
      "type": "float",
      "min": 0
    },
    "unit": {
      "type": "enum",
      "options": [
        "carton",
        "ctn",
        "kg",
        "g",
        "ton",
        "pcs",
        "set",
        "box",
        "bottle",
        "can",
        "bag",
        "container20",
        "container40"
      ]
    },
    "destination": {
      "type": "varchar",
      "maxLength": 255
    },
    "deliveryWindow": {
      "type": "varchar",
      "maxLength": 255
    },
    "packagingRequirement": {
      "type": "varchar",
      "maxLength": 255
    },
    "certificatesNeeded": {
      "type": "text"
    },
    "customerTargetPrice": {
      "type": "float",
      "min": 0
    },
    "customerTargetCurrency": {
      "type": "enum",
      "options": [
        "USD",
        "CNY",
        "EUR"
      ]
    },
    "notes": {
      "type": "text"
    },
    "assignedUser": {
      "type": "link",
      "view": "views/fields/assigned-user"
    },
    "teams": {
      "type": "linkMultiple",
      "view": "views/fields/teams"
    },
    "createdAt": {
      "type": "datetime",
      "readOnly": true
    },
    "modifiedAt": {
      "type": "datetime",
      "readOnly": true
    },
    "createdBy": {
      "type": "link",
      "readOnly": true
    },
    "modifiedBy": {
      "type": "link",
      "readOnly": true
    }
  },
  "links": {
    "account": {
      "type": "belongsTo",
      "entity": "Account"
    },
    "contact": {
      "type": "belongsTo",
      "entity": "Contact"
    },
    "conversation": {
      "type": "belongsTo",
      "entity": "ExternalConversation"
    },
    "product": {
      "type": "belongsTo",
      "entity": "FusanheProduct"
    },
    "productSpec": {
      "type": "belongsTo",
      "entity": "FusanheProductSpec"
    },
    "quotes": {
      "type": "hasMany",
      "entity": "FusanheQuote",
      "foreign": "inquiry"
    },
    "assignedUser": {
      "type": "belongsTo",
      "entity": "User"
    },
    "teams": {
      "type": "hasMany",
      "entity": "Team",
      "relationName": "entityTeam",
      "layoutRelationshipsDisabled": true
    },
    "createdBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "modifiedBy": {
      "type": "belongsTo",
      "entity": "User"
    }
  },
  "collection": {
    "orderBy": "createdAt",
    "order": "desc",
    "textFilterFields": [
      "name",
      "number",
      "destination"
    ]
  },
  "indexes": {
    "status": {
      "columns": [
        "status"
      ]
    }
  }
}
